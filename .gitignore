# Competition data is login-gated and must never be committed.
/data/
/cache/
/.cache/
*.tif
*.tiff
*.zip
# Exception: the two disclosed H67-1 siblings ARE the deliverable and must be served by
# GitHub Pages, so they are tracked on purpose (they are ~0.3 MB each). Nothing else in
# docs/downloads is published; see docs/downloads/README.md for the disclosure text.
!docs/downloads/gems66-h67-scarp-lane-novelty-40000dots-v2-nan.tif
!docs/downloads/gems66-h67-scarp-lane-novelty-40000dots-v2-zeros.tif

# Generated/model outputs stay local.
/outputs/
/runs/
/checkpoints/
*.pt
*.pth
*.ckpt
*.safetensors
*.npy
*.npz

# Local environments, credentials and caches.
.venv/
venv/
.env
.env.*
!.env.example
__pycache__/
.pytest_cache/
*.egg-info/
build/
dist/

# --- from the lane session (arena/7d2c4a3b) ---
# The registry rasters and audited artifacts are INTENTIONALLY tracked: they are the
# duplicate-gate corpus and the audit trail. They are already in the index, so these
# patterns only stop NEW stray rasters from being added by accident.
*.py[cod]
.mypy_cache/
.ruff_cache/
.cache/
# Python build/env extras
profile_output/
.coverage
htmlcov/
# OS / editor
.vscode/
.idea/
.DS_Store
Thumbs.db

# Cleared release rasters must be publishable on GitHub Pages even though raster/binary archives
# are otherwise kept out of Git.  These are our own predictions (hundreds of KB), not organizer or
# competition data, so the "/data/" and mirrored-raster rules above still hold.  Each lane's
# builder only ever touches its own filename prefix inside docs/downloads/.
!docs/downloads/*.tif
!docs/downloads/*.zip
